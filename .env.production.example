# Production settings for docker-compose.prod.yml. Copy to .env.production on the server
# (never commit it), fill in every <...>, and generate fresh secrets:
#   python3 scripts/init_env.py --production
# The API refuses to start if a setting is unsafe for production.

ENV=production
# The website's public address (Vercel, or your own domain pointed at it).
APP_BASE_URL=https://<your-site>.vercel.app

# --- Secrets (generate, don't reuse the development ones) ---
SECRET_KEY=<generated>
ENCRYPTION_KEYS=<generated>
FILE_MASTER_KEY=<generated>
POSTGRES_PASSWORD=<a long random password>

# --- HTTPS tunnel (Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token) ---
CLOUDFLARE_TUNNEL_TOKEN=<token>

# --- AI (free tiers) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=<key>
WRITING_LLM_PROVIDER=groq
GROQ_API_KEY=<key>
LLM_RPM=10
LLM_RPD=500
EMBEDDING_PROVIDER=fastembed

# --- Job sources ---
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
HUNTER_API_KEY=

# --- Google (sign-in, Gmail, Sheets) ---
# Add these redirect URIs to the OAuth client (same host as APP_BASE_URL):
#   https://<your-site>/api/v1/auth/google/callback
#   https://<your-site>/api/v1/integrations/gmail/callback
#   https://<your-site>/api/v1/integrations/sheets/callback
GOOGLE_CLIENT_ID=<id>
GOOGLE_CLIENT_SECRET=<secret>

# --- Sending applications: always the user's own Gmail in production ---
APPLICATION_SEND_BACKEND=gmail
DEFAULT_DAILY_SEND_CAP=25
MAX_DAILY_SEND_CAP=50

# --- Account email (verification, password reset, digests) ---
# Free options: a Gmail account with an app password, or Resend's free SMTP.
#   Gmail:  smtp+starttls://you%40gmail.com:<app-password>@smtp.gmail.com:587
#   Resend: smtps://resend:<api-key>@smtp.resend.com:465
MAIL_BACKEND=smtp
SMTP_URL=<smtp url>
MAIL_FROM="JobPilot AI <you@gmail.com>"

# --- Safety (must stay on in production) ---
RATE_LIMIT_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true
LOG_LEVEL=INFO
