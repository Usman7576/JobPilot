# Overrides for running the API/worker directly on your PC (not in Docker), layered on
# top of ../.env:  uv run --env-file ../.env --env-file .env.host ...
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
TEST_DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot_test
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SMTP_URL=smtp://localhost:1025
LOCAL_STORAGE_PATH=../data/uploads
MODEL_CACHE_DIR=../data/models
