# Copy to .env with:  python scripts/init_env.py
# (it fills SECRET_KEY, ENCRYPTION_KEYS and FILE_MASTER_KEY with fresh random values)

# --- Core ---
ENV=development
APP_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000
SECRET_KEY=
ENCRYPTION_KEYS=
FILE_MASTER_KEY=
REQUIRE_EMAIL_VERIFICATION=true
RATE_LIMIT_ENABLED=true

# --- Database / Redis ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@postgres:5432/jobpilot
TEST_DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@postgres:5432/jobpilot_test
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/uploads

# --- AI (free stack: Gemini free tier + local fastembed) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Optional: a separate model just for writing emails/cover letters, e.g. Claude:
#   WRITING_LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY (paid, ~1.5 cents per letter)
WRITING_LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
LLM_RPM=10
LLM_RPD=500
STAGE1_TOP_N=15
NORMALIZE_WITH_LLM=false

# --- Job sources (all free) ---
# Arbeitnow needs no key and is on by default. Free keys switch on more sources:
#   Adzuna: https://developer.adzuna.com/signup   Jooble: https://jooble.org/api/about
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_DEFAULT_COUNTRY=us
JOOBLE_API_KEY=
# SerpAPI (Google Jobs) has a small free monthly quota: https://serpapi.com
SERPAPI_KEY=
# JobSpy scraping (LinkedIn/Indeed/Glassdoor/Google) is opt-in per user in Settings.
JOBSPY_PROXIES=
JOBSPY_FETCH_DESCRIPTION=false
JOBSPY_COUNTRY_INDEED=usa
SOURCE_MAX_QUERIES_PER_RUN=6

# --- Google OAuth (login + Gmail/Sheets) ---
# Authorized redirect URIs to add in Google Cloud Console:
#   http://localhost:3000/api/v1/auth/google/callback
#   http://localhost:3000/api/v1/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Contact discovery ---
# Optional (free plan: 25 searches/month): finds recruiter emails when a posting has none.
HUNTER_API_KEY=

# --- Sending ---
DEFAULT_DAILY_SEND_CAP=25
MAX_DAILY_SEND_CAP=50
DEFAULT_FOLLOW_UP_DAYS=7
# gmail = send from the user's connected Gmail. smtp = local testing only: applications
# are delivered to SMTP_URL (Mailpit at http://localhost:8025), never to real recipients.
APPLICATION_SEND_BACKEND=gmail

# --- Transactional email (verification links, digests) ---
# smtp + mailpit in dev: open http://localhost:8025 to read mail
MAIL_BACKEND=smtp
SMTP_URL=smtp://mailpit:1025
MAIL_FROM="JobPilot AI <noreply@jobpilot.local>"

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=false
SENTRY_DSN=
