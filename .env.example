# Copy to .env with:  python scripts/init_env.py
# (it fills SECRET_KEY, ENCRYPTION_KEYS and FILE_MASTER_KEY with fresh random values)

# --- Core ---
ENV=development
APP_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000
SECRET_KEY=
ENCRYPTION_KEYS=
FILE_MASTER_KEY=
REQUIRE_EMAIL_VERIFICATION=true
RATE_LIMIT_ENABLED=true

# --- Database / Redis ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@postgres:5432/jobpilot
TEST_DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@postgres:5432/jobpilot_test
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/uploads

# --- AI (free stack: Gemini free tier + local fastembed) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
LLM_RPM=10
LLM_RPD=500
STAGE1_TOP_N=15
NORMALIZE_WITH_LLM=false

# --- Sources ---
SOURCES_ENABLED=linkedin,indeed,glassdoor,google
SERPAPI_KEY=
JOBSPY_PROXIES=

# --- Google OAuth (login + Gmail/Sheets) ---
# Authorized redirect URIs to add in Google Cloud Console:
#   http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Contact discovery ---
HUNTER_API_KEY=

# --- Sending ---
DEFAULT_DAILY_SEND_CAP=25
MAX_DAILY_SEND_CAP=50
DEFAULT_FOLLOW_UP_DAYS=7

# --- Transactional email (verification links, digests) ---
# smtp + mailpit in dev: open http://localhost:8025 to read mail
MAIL_BACKEND=smtp
SMTP_URL=smtp://mailpit:1025
MAIL_FROM="JobPilot AI <noreply@jobpilot.local>"

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=false
SENTRY_DSN=
