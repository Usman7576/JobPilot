  "components": {
    "schemas": {
      "AuthConfigOut": {
        "properties": {
          "google_login_enabled": {
            "type": "boolean",
            "title": "Google Login Enabled"
          },
          "require_email_verification": {
            "type": "boolean",
            "title": "Require Email Verification"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "google_login_enabled",
          "require_email_verification"
        ],
        "title": "AuthConfigOut"
      },
      "Body_resumes_upload_resume": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_resumes_upload_resume"
      },
      "Certification": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "title": "Name"
          },
          "issuer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Issuer"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Certification"
      },
      "Contact": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Links"
          }
        },
        "type": "object",
        "title": "Contact"
      },
      "EducationEntry": {
        "properties": {
          "institution": {
            "type": "string",
            "maxLength": 200,
            "title": "Institution"
          },
          "degree": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Degree"
          },
          "field": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "gpa": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Gpa"
          }
        },
        "type": "object",
        "required": [
          "institution"
        ],
        "title": "EducationEntry"
      },
      "ForgotPasswordIn": {
